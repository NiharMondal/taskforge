generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

//// ENUMS

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// What a workflow status means to the code, whatever the project calls it
// (spec/workflow-spec.md).
enum StatusCategory {
  BACKLOG
  UNSTARTED
  STARTED
  COMPLETED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

// Stripe's subscription statuses, one for one. ACTIVE, TRIALING and PAST_DUE
// keep a paid plan in force (`effectivePlan` in @taskforge/shared).
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  UNPAID
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

//// AUTH
// One row per way a user can sign in. EMAIL rows carry the password hash;
// provider rows (GOOGLE, ...) carry the provider's stable account id. The email
// itself is identity, not a credential, so it lives on `User`.
// A password sign-up waiting for its email to be confirmed. No User exists
// until the link in the email is followed (POST /auth/verify-email), so an
// address nobody has proven gets no account, token or workspace. Several may
// be pending for one email; whichever link is followed wins, with its own
// password, and the rest are deleted.
model PendingRegistration {
  id           String   @id @default(uuid())
  email        String
  name         String
  passwordHash String
  // SHA-256 of the token in the emailed link; the token itself is never stored.
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
}

// One refresh token. Each use replaces it with a new one in the same family
// (one family per sign-in); presenting a replaced token after the grace period
// means it leaked, and revokes the whole family. See RefreshTokenService.
// A "forgot password" link. Following it sets the user's password (creating
// the EMAIL sign-in method for a Google-only account) and ends every session.
model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the token in the emailed link; the token itself is never stored.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId   String
  // SHA-256 of the token; the token itself is never stored.
  tokenHash  String    @unique
  expiresAt  DateTime
  // Set when this token was exchanged for a new one.
  replacedAt DateTime?
  // Set on sign-out, on reuse, and when the account's password is dropped.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Auth {
  id         String       @id @default(uuid())
  provider   AuthProvider
  providerId String? // provider's stable account id (Google `sub`); null for EMAIL
  password   String? // bcrypt hash; only set for EMAIL
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

//// USERS
model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  avatarUrl       String?
  avatarPublicId  String?
  // When someone proved they own `email`: a Google sign-in, or the link in the
  // verification email that finishes a password registration. Null only on
  // password accounts registered before verification existed; they can't sign
  // in with a password until they register again, and a first Google sign-in
  // drops that password (see AuthService.googleSignIn).
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auths          Auth[]
  memberships    Membership[]
  createdIssues  Issue[]      @relation("CreatedIssues")
  assignedIssues Issue[]      @relation("AssignedIssues")

  comments       Comment[]
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
}

//// WORKSPACE (TENANT ROOT)

model Workspace {
  id          String  @id @default(uuid())
  name        String
  slug        String  @default(cuid())
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  projects         Project[]
  issues           Issue[]
  sprints          Sprint[]
  invitations      Invitation[]
  subscription     Subscription?
  auditLogs        AuditLog[]
  labels           Label[]
  roles            Role[]
  workflowStatuses WorkflowStatus[]
}

//// MEMBERSHIP (RBAC CORE)

model Membership {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  // The Role row that decides this member's permissions. `role` above is kept
  // in step (system roles only) until custom roles land; null only for rows
  // written before roles existed, which WorkspaceGuard maps through `role`.
  roleId      String?

  createdAt DateTime @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // NoAction (not Restrict): a role still in use can't be deleted, but deleting
  // the workspace may still cascade to both roles and memberships.
  assignedRole Role?     @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([roleId])
}

/// A workspace's role: a named set of permission keys (see
/// src/common/permissions/permissions.ts). Every workspace has the four
/// built-ins, marked by `systemKey`. OWNER's `permissions` are not read — the
/// owner implicitly holds every permission.
model Role {
  id          String         @id @default(uuid())
  workspaceId String
  name        String
  systemKey   WorkspaceRole?
  permissions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, systemKey])
}

//// PROJECTS

model Project {
  id           String  @id @default(uuid())
  name         String
  // Human-readable prefix for issue keys (e.g. "WA" → WA-12), derived from the
  // name on create and never changed after, so keys people have shared stay
  // valid. Unique within the workspace.
  key          String
  description  String?
  // The last issue number handed out; the next issue gets issueCounter + 1.
  issueCounter Int     @default(0)

  workspaceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  issues      Issue[]
  sprints     Sprint[]
  statuses    WorkflowStatus[]
  transitions WorkflowTransition[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

//// WORKFLOWS

// One column of a project's board (spec/workflow-spec.md). Every project has its
// own, seeded from DEFAULT_WORKFLOW_STATUSES in @taskforge/shared on create.
model WorkflowStatus {
  id        String         @id @default(uuid())
  name      String
  // Hex, like a label's color.
  color     String
  category  StatusCategory
  // Column order: a fractional-indexing key, like Issue.rank. The column is
  // COLLATE "C" (set in the custom_workflows migration) for the same reason.
  position  String
  // Where an issue lands when created without a status. Exactly one per project.
  isDefault Boolean        @default(false)

  workspaceId String
  projectId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issues          Issue[]
  transitionsFrom WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo   WorkflowTransition[] @relation("TransitionTo")

  @@index([workspaceId, projectId])
  @@index([projectId, position])
}

// A move an issue may make between two statuses of one project. Staying in the
// same status is always allowed and never stored.
model WorkflowTransition {
  projectId    String
  fromStatusId String
  toStatusId   String

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus WorkflowStatus @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   WorkflowStatus @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@id([fromStatusId, toStatusId])
  @@index([projectId])
  @@index([toStatusId])
}

//// SPRINTS

model Sprint {
  id   String  @id @default(uuid())
  name String
  goal String?

  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(false)
  // Set when the sprint is ended; a completed sprint can't be started again.
  // (`endDate` can't mark this: it is also a planned date set on create.)
  completedAt DateTime?

  projectId   String
  workspaceId String

  createdAt DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  issues Issue[]

  @@index([projectId])
  @@index([workspaceId])
}

//// ISSUES (CORE)

model Issue {
  id          String  @id @default(uuid())
  title       String
  description String?

  // A status of the issue's own project's workflow. A status is never deleted
  // with issues in it (WorkflowService moves them first). NoAction, not
  // Restrict: Postgres checks it at the end of the statement, so deleting a
  // project or workspace can cascade to issues and statuses in either order.
  statusId String
  priority IssuePriority @default(MEDIUM)
  type     IssueType     @default(TASK)
  // Per-project sequence, shown with the project key as `WA-12`. Allocated
  // from Project.issueCounter on create; never reused.
  number   Int
  // Board ordering within a (project, statusId) lane. Fractional index
  // (base-62 string, e.g. "a0", "a0V") so a card can be inserted between any
  // two neighbors without renumbering siblings — generated client-side via the
  // `fractional-indexing` lib. Nullable so it can be added over existing rows;
  // backfill then sort lanes by `rank ASC` (NULLS LAST as a safety net).
  // The column is COLLATE "C" (byte order, set in the issue_rank_byte_order
  // migration) — locale collations sort these keys wrongly.
  rank     String?

  workspaceId String
  projectId   String
  sprintId    String?

  // Null once the reporter's account is deleted: their issues stay with the
  // workspace (SetNull), shown as reported by "Deleted user".
  reporterId String?
  assigneeId String?

  parentIssueId String?

  //estimate
  timeEstimate Int? // Optional but useful for sprints

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint    Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  status    WorkflowStatus @relation(fields: [statusId], references: [id], onDelete: NoAction)

  reporter User? @relation("CreatedIssues", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee User? @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Self relation
  parentIssue Issue?  @relation("IssueHierarchy", fields: [parentIssueId], references: [id], onDelete: Cascade)
  subIssues   Issue[] @relation("IssueHierarchy")

  comments Comment[]
  labels   IssueLabel[]

  @@unique([projectId, number])
  @@index([workspaceId, projectId])
  @@index([workspaceId, statusId])
  @@index([workspaceId, assigneeId])
  // Foreign keys Postgres doesn't index on its own: ending a sprint filters on
  // sprintId, and deleting a parent cascades through parentIssueId.
  @@index([sprintId])
  @@index([parentIssueId])
  // Serves the board query: WHERE projectId=? AND statusId=? ORDER BY rank.
  @@index([projectId, statusId, rank])
}

//// COMMENTS

model Comment {
  id      String @id @default(uuid())
  content String

  issueId String
  // The author; null once their account is deleted, so the conversation stays.
  userId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([issueId])
}

//// LABELS

model Label {
  id    String @id @default(uuid())
  name  String
  color String

  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  issues IssueLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  // The primary key leads with issueId, so it can't serve lookups by label.
  @@index([labelId])
}

//// INVITATIONS
model Invitation {
  id          String           @id @default(uuid())
  email       String
  workspaceId String
  role        WorkspaceRole    @default(MEMBER)
  roleId      String?
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedRole Role?     @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@unique([email, workspaceId])
  @@index([workspaceId])
  @@index([roleId])
}

//// SUBSCRIPTION (SAAS LAYER)

// One per workspace, written by the billing module (`spec/billing-spec.md`).
// No row means FREE. `status` is null while only the Stripe customer exists
// (checkout started, nothing subscribed yet); the webhook writes the rest.
model Subscription {
  id          String @id @default(uuid())
  workspaceId String @unique

  plan   SubscriptionPlan    @default(FREE)
  status SubscriptionStatus?

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Stripe's quantity: members billed for.
  seats             Int?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  trialEndsAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Stripe webhook events already applied. Stripe may deliver an event more than
// once; its id is recorded in the same transaction that applies it.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

//// AUDIT LOGS

model AuditLog {
  id String @id @default(uuid())

  workspaceId String
  userId      String?

  action     String
  entityType String
  entityId   String?

  metadata Json?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Serves an entity's history (an issue's timeline): WHERE workspaceId,
  // entityType, entityId ORDER BY createdAt. Its prefix also covers lookups by
  // workspace alone, which the old single-column index did.
  @@index([workspaceId, entityType, entityId, createdAt])
  // Serves the workspace audit log (GET /audit-log): a workspace's rows,
  // newest first.
  @@index([workspaceId, createdAt])
  @@index([entityType])
}

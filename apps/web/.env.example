# Base URL of the backend API. Used by src/lib/axios.ts.
# Copy this file to .env.local and adjust as needed.
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# Secret used by Auth.js (next-auth v5) to sign/encrypt the session JWT.
# REQUIRED. Generate one with: openssl rand -base64 33
# Auth.js reads AUTH_SECRET automatically (alias of NEXTAUTH_SECRET).
AUTH_SECRET=replace-me-with-a-strong-random-secret

# Google OAuth ("Continue with Google"). Read by src/lib/auth.ts.
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# -> APIs & Services -> Credentials, and add this Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
# If these are unset, Auth.js sends Google `client_id=undefined` and sign-in fails.
GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>

# Cloudinary 
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME = <cloud_name>
NEXT_PUBLIC_CLOUDINARY_PRESET_NAME = <preset_name>
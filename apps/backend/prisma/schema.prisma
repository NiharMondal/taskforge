generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

//// ENUMS

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  QA_REQUESTED
  QA_FAILED
  DEPLOYED
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

//// AUTH
// One row per way a user can sign in. EMAIL rows carry the password hash;
// provider rows (GOOGLE, ...) carry the provider's stable account id. The email
// itself is identity, not a credential, so it lives on `User`.
model Auth {
  id         String       @id @default(uuid())
  provider   AuthProvider
  providerId String? // provider's stable account id (Google `sub`); null for EMAIL
  password   String? // bcrypt hash; only set for EMAIL
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@unique([userId, provider])
}

//// USERS
model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  avatarUrl       String?
  avatarPublicId  String?
  // When someone proved they own `email` (today: a Google sign-in). Null means
  // nobody has — e.g. a password registration — and a first Google sign-in
  // then drops that password (see AuthService.googleSignIn).
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auths          Auth[]
  memberships    Membership[]
  createdIssues  Issue[]      @relation("CreatedIssues")
  assignedIssues Issue[]      @relation("AssignedIssues")

  comments  Comment[]
  auditLogs AuditLog[]
}

//// WORKSPACE (TENANT ROOT)

model Workspace {
  id          String  @id @default(uuid())
  name        String
  slug        String  @default(cuid())
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  projects     Project[]
  issues       Issue[]
  sprints      Sprint[]
  invitations  Invitation[]
  subscription Subscription?
  auditLogs    AuditLog[]
  labels       Label[]
  roles        Role[]
}

//// MEMBERSHIP (RBAC CORE)

model Membership {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  // The Role row that decides this member's permissions. `role` above is kept
  // in step (system roles only) until custom roles land; null only for rows
  // written before roles existed, which WorkspaceGuard maps through `role`.
  roleId      String?

  createdAt DateTime @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // NoAction (not Restrict): a role still in use can't be deleted, but deleting
  // the workspace may still cascade to both roles and memberships.
  assignedRole Role?     @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([roleId])
}

/// A workspace's role: a named set of permission keys (see
/// src/common/permissions/permissions.ts). Every workspace has the four
/// built-ins, marked by `systemKey`. OWNER's `permissions` are not read — the
/// owner implicitly holds every permission.
model Role {
  id          String         @id @default(uuid())
  workspaceId String
  name        String
  systemKey   WorkspaceRole?
  permissions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, systemKey])
}

//// PROJECTS

model Project {
  id          String  @id @default(uuid())
  name        String
  key         String  @default(cuid())
  description String?

  workspaceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  issues  Issue[]
  sprints Sprint[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

//// SPRINTS

model Sprint {
  id   String  @id @default(uuid())
  name String
  goal String?

  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(false)

  projectId   String
  workspaceId String

  createdAt DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  issues Issue[]

  @@index([projectId])
  @@index([workspaceId])
}

//// ISSUES (CORE)

model Issue {
  id          String  @id @default(uuid())
  title       String
  description String?

  status   IssueStatus   @default(BACKLOG)
  priority IssuePriority @default(MEDIUM)
  type     IssueType     @default(TASK)
  // Board ordering within a (project, status) lane. Fractional index
  // (base-62 string, e.g. "a0", "a0V") so a card can be inserted between any
  // two neighbors without renumbering siblings — generated client-side via the
  // `fractional-indexing` lib. Nullable so it can be added over existing rows;
  // backfill then sort lanes by `rank ASC` (NULLS LAST as a safety net).
  // The column is COLLATE "C" (byte order, set in the issue_rank_byte_order
  // migration) — locale collations sort these keys wrongly.
  rank     String?

  workspaceId String
  projectId   String
  sprintId    String?

  reporterId String
  assigneeId String?

  parentIssueId String?

  //estimate
  timeEstimate Int? // Optional but useful for sprints

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint    Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  reporter User  @relation("CreatedIssues", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee User? @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Self relation
  parentIssue Issue?  @relation("IssueHierarchy", fields: [parentIssueId], references: [id], onDelete: Cascade)
  subIssues   Issue[] @relation("IssueHierarchy")

  comments Comment[]
  labels   IssueLabel[]

  @@index([workspaceId, projectId])
  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  // Serves the board query: WHERE projectId=? AND status=? ORDER BY rank.
  @@index([projectId, status, rank])
}

//// COMMENTS

model Comment {
  id      String @id @default(uuid())
  content String

  issueId String
  userId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

//// LABELS

model Label {
  id    String @id @default(uuid())
  name  String
  color String

  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  issues IssueLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
}

//// INVITATIONS
model Invitation {
  id          String           @id @default(uuid())
  email       String
  workspaceId String
  role        WorkspaceRole    @default(MEMBER)
  roleId      String?
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedRole Role?     @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@unique([email, workspaceId])
  @@index([token])
  @@index([workspaceId])
  @@index([roleId])
}

//// SUBSCRIPTION (SAAS LAYER)

model Subscription {
  id          String @id @default(uuid())
  workspaceId String @unique

  plan   SubscriptionPlan @default(FREE)
  status String?

  stripeCustomerId     String?
  stripeSubscriptionId String?

  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

//// AUDIT LOGS

model AuditLog {
  id String @id @default(uuid())

  workspaceId String
  userId      String?

  action     String
  entityType String
  entityId   String?

  metadata Json?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([entityType])
}

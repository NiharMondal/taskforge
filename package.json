{
  "name": "taskforge",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "free-ports": "lsof -ti tcp:3000,5001,5002 -sTCP:LISTEN | xargs kill 2>/dev/null || true",
    "predev": "pnpm run free-ports",
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "dev:web": "pnpm --filter @taskforge/web run dev",
    "dev:backend": "pnpm --filter @taskforge/backend run dev",
    "build": "pnpm --filter \"./apps/*\" run build",
    "lint": "pnpm --filter \"./apps/*\" run lint",
    "lint:check": "pnpm --filter @taskforge/backend run lint:check && pnpm --filter @taskforge/web run lint",
    "typecheck": "pnpm --filter @taskforge/shared run typecheck && pnpm --filter @taskforge/web run typecheck && pnpm --filter @taskforge/backend exec tsc --noEmit",
    "test": "pnpm --filter @taskforge/backend run test",
    "test:e2e": "pnpm --filter @taskforge/backend run test:e2e",
    "db:generate": "pnpm --filter @taskforge/backend exec prisma generate",
    "db:migrate": "pnpm --filter @taskforge/backend exec prisma migrate dev",
    "db:studio": "pnpm --filter @taskforge/backend run studio",
    "postinstall": "pnpm run db:generate"
  }
}

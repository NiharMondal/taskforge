# Local Postgres. With `docker compose up -d` (repo root) this is:
#   postgresql://taskforge:taskforge@localhost:5433/taskforge?schema=public
DATABASE_URL = postgresql://<username>:<password>@localhost:5432/taskforge?schema=public
NODE_ENV = development
PORT = 5001
# Comma-separated origins allowed by CORS. Unset = http://localhost:3000,http://localhost:3001
CORS_ORIGINS = http://localhost:3000
# Signs access tokens. REQUIRED. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET = replace-me-with-a-strong-random-secret

# Google OAuth client ID ("Continue with Google"). The backend uses it to verify
# the ID token the web app forwards, so it MUST be the same client ID as
# GOOGLE_CLIENT_ID in apps/web/.env.local. Without it, POST /auth/google answers 503.
GOOGLE_CLIENT_ID = <google_client_id>

# Stripe billing (spec/billing-spec.md). Optional: without them the backend
# boots, the Free plan's limits apply, and checkout/portal/webhook answer 503.
# Use test-mode keys locally. STRIPE_PRO_PRICE_ID is the recurring, per-unit
# monthly price of the "TaskForge Pro" product. For local webhooks run
#   stripe listen --forward-to localhost:5001/api/v1/billing/webhook
# and paste the whsec_... it prints.
STRIPE_SECRET_KEY = <sk_test_...>
STRIPE_PRO_PRICE_ID = <price_...>
STRIPE_WEBHOOK_SECRET = <whsec_...>

# Daily cleanup (spec/maintenance-spec.md). It runs in-process at 03:17 UTC; set
# CRON_SECRET to also let an external scheduler trigger it with
#   POST /api/v1/maintenance/cleanup   Authorization: Bearer <CRON_SECRET>
# (needed on hosts that sleep, e.g. Render's free tier). Unset: that route is a 503.
# Generate one with: openssl rand -hex 32
CRON_SECRET = <long_random_string>

# SMTP / email (used by MailService for invitation emails)
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 465
# SMTP_PORT = 587
SMTP_SECURE = true
SMTP_USER = <your_email>
SMTP_PASS = <password>
MAIL_FROM = "Taskforge <no-reply@<your_app_email>.app>"
APP_URL = http://localhost:3000


# Cloudinray Secret
CLOUDINARY_CLOUD_NAME = <cloud_name>
CLOUDINARY_API_KEY = <api_key>
CLOUDINARY_API_SECRET = <api_secret>
